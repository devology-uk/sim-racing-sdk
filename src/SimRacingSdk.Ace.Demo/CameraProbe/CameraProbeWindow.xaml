<Window x:Class="SimRacingSdk.Ace.Demo.CameraProbe.CameraProbeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimRacingSdk.Ace.Demo.CameraProbe"
        xmlns:con="clr-namespace:SimRacingSdk.Ace.Demo.Controls.Console"
        mc:Ignorable="d"
        Title="Camera Control Probe"
        Height="700"
        Width="900"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        d:DataContext="{d:DesignInstance local:CameraProbeViewModel}">
    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="Margin"
                    Value="5,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <GroupBox Grid.Row="0"
                  Header="State">
            <StackPanel Orientation="Horizontal">
                <Label Content="{Binding GameStatus}"
                       FontWeight="SemiBold" />
                <Label Content="Focused car:"
                       Margin="20,0,0,0" />
                <Label Content="{Binding FocusedCar}" />
                <Label Content="Player car:"
                       Margin="20,0,0,0" />
                <Label Content="{Binding PlayerCar}" />
                <Label Content="Active cars:"
                       Margin="20,0,0,0" />
                <Label Content="{Binding ActiveCars}" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="1"
                  Header="Send keys to ACE"
                  Margin="0,10">
            <StackPanel Orientation="Horizontal"
                        Margin="5">
                <Label Content="Key" />
                <ComboBox ItemsSource="{Binding Keys}"
                          SelectedItem="{Binding SelectedKey}"
                          Width="110"
                          VerticalAlignment="Center" />
                <CheckBox Content="Ctrl"
                          IsChecked="{Binding IsControlPressed}" />
                <CheckBox Content="Shift"
                          IsChecked="{Binding IsShiftPressed}" />
                <CheckBox Content="Alt"
                          IsChecked="{Binding IsAltPressed}" />
                <Label Content="Repeat"
                       Margin="15,0,0,0" />
                <TextBox Text="{Binding RepeatCount}"
                         Width="40"
                         VerticalAlignment="Center" />
                <Label Content="Delay (ms)" />
                <TextBox Text="{Binding PressDelayMs}"
                         Width="60"
                         VerticalAlignment="Center" />
                <Button Content="Send to ACE"
                        Command="{Binding SendKeyCommand}"
                        Margin="15,0,0,0"
                        Padding="10,3"
                        ToolTip="Brings the ACE window to the front, then sends the key. Disabled until ACE is running." />
                <Button Content="Log Car Table"
                        Command="{Binding LogCarTableCommand}"
                        Margin="10,0,0,0"
                        Padding="10,3"
                        ToolTip="Logs every car's index, id and coordinates from shared memory" />
            </StackPanel>
        </GroupBox>

        <con:ConsoleControl Grid.Row="2" />
    </Grid>
</Window>

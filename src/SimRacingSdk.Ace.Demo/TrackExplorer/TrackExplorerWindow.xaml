<Window x:Class="SimRacingSdk.Ace.Demo.TrackExplorer.TrackExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimRacingSdk.Ace.Demo.TrackExplorer"
        mc:Ignorable="d"
        Title="Track Explorer"
        Height="500"
        Width="800"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        Background="LightGray"
        d:DataContext="{d:DesignInstance local:TrackExplorerViewModel}">
    <Window.InputBindings>
        <KeyBinding Gesture="CTRL+SHIFT+ALT+C"
                    Command="{Binding ExportCsvCommand}" />
    </Window.InputBindings>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <ListBox Grid.Column="0"
                 ItemsSource="{Binding TrackNames}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Stretch"
                 SelectedItem="{Binding SelectedTrackName, Mode=TwoWay}"
                 MinWidth="180" />

        <ListBox Grid.Column="1"
                 ItemsSource="{Binding Layouts}"
                 DisplayMemberPath="Layout"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Stretch"
                 SelectedItem="{Binding SelectedLayout, Mode=TwoWay}"
                 MinWidth="120" />

        <GroupBox Grid.Column="2"
                  Header="Layout Details"
                  Margin="5"
                  VerticalAlignment="Top"
                  DataContext="{Binding SelectedLayout}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Column="0"
                       Grid.Row="0"
                       Content="Track"
                       FontWeight="Bold" />
                <Label Grid.Column="1"
                       Grid.Row="0"
                       Content="{Binding Track}"
                       FontWeight="Bold"
                       FontSize="16" />

                <Label Grid.Column="0"
                       Grid.Row="1"
                       Content="Layout"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="1"
                       Content="{Binding Layout}" />

                <Label Grid.Column="0"
                       Grid.Row="2"
                       Content="Length (m)"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="2"
                       Content="{Binding TrackLengthMeters}" />

                <Label Grid.Column="0"
                       Grid.Row="3"
                       Content="Max Pit Slot"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="3"
                       Content="{Binding MaxPitSlot}" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>

<UserControl x:Class="SimRacingSdk.Lmu.DataManager.Cars.CarsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SimRacingSdk.Lmu.DataManager.Cars"
             xmlns:controls="clr-namespace:SimRacingSdk.DataManager.Shared.Controls;assembly=SimRacingSdk.DataManager.Shared"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:CarsViewModel}">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/SimRacingSdk.DataManager.Shared;component/Themes/EditorForm.xaml" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
            <RadioButton Content="By Class"
                         GroupName="CarBrowseMode"
                         VerticalAlignment="Center"
                         Margin="0,0,15,0"
                         IsChecked="{Binding BrowseMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ByGroup}" />
            <RadioButton Content="All Cars"
                         GroupName="CarBrowseMode"
                         VerticalAlignment="Center"
                         IsChecked="{Binding BrowseMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All}" />
        </StackPanel>

        <ListBox Grid.Row="1"
                 Grid.Column="0"
                 ItemsSource="{Binding Groups}"
                 SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                 Visibility="{Binding IsByGroupMode, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="250" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      controls:ScrollSelectedIntoView.IsEnabled="True"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Manufacturer"
                                        Binding="{Binding Manufacturer}" />
                    <DataGridTextColumn Header="Display Name"
                                        Binding="{Binding DisplayName}" />
                    <DataGridTextColumn Header="Class"
                                        Binding="{Binding Class}" />
                    <DataGridTextColumn Header="Category"
                                        Binding="{Binding Category}" />
                    <DataGridTextColumn Header="Year"
                                        Binding="{Binding Year}" />
                    <DataGridTextColumn Header="Model Id"
                                        Binding="{Binding ModelId}" />
                    <DataGridTextColumn Header="Power (kW)"
                                        Binding="{Binding PowerKw}" />
                    <DataGridTextColumn Header="Weight (kg)"
                                        Binding="{Binding WeightKg}" />
                </DataGrid.Columns>
            </DataGrid>

            <GroupBox Grid.Row="1"
                      Header="Car Details"
                      Margin="0,10,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,10,0,15">
                        <Button Content="New Car"
                                Command="{Binding NewCommand}"
                                Padding="10,4"
                                Margin="0,0,10,0" />
                        <Button Content="Save Car"
                                Command="{Binding SaveCommand}"
                                Padding="10,4"
                                Margin="0,0,15,0" />
                        <TextBlock Text="{Binding SaveStatusMessage}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid DataContext="{Binding Editor}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Content="Display Name" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Grid.Row="0"
                               Grid.Column="2"
                               Content="Manufacturer" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="3"
                                 Text="{Binding Manufacturer, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Grid.Row="0"
                               Grid.Column="4"
                               Content="Year" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="5"
                                 Text="{Binding Year, UpdateSourceTrigger=LostFocus}" />

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Content="Class" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  IsEditable="True"
                                  ItemsSource="{Binding DataContext.Groups, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Text="{Binding CarClass, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="The game's class code (HY, GT3, GTE, P2, P3) - pick one or type a new one" />
                        <Label Grid.Row="1"
                               Grid.Column="2"
                               Content="Category" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="3"
                                 Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="The regulation the car is built to: LMH, LMDh, LMGT3, GTE, LMP2 or LMP3" />
                        <Label Grid.Row="1"
                               Grid.Column="4"
                               Content="Model Id" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="5"
                                 Text="{Binding ModelId, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                 ToolTip="The vehicle folder from a setup file's //VEH= comment, e.g. 911GT3R_2024. Leave blank until seen." />

                        <Label Grid.Row="2"
                               Grid.Column="0"
                               Content="Result Car Type" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding ResultCarType, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="The CarType a result file reports - doesn't always match Display Name" />
                        <Label Grid.Row="2"
                               Grid.Column="2"
                               Content="Engine" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="3"
                                 Text="{Binding Engine, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Grid.Row="2"
                               Grid.Column="4"
                               Content="Transmission" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="5"
                                 Text="{Binding Transmission, UpdateSourceTrigger=PropertyChanged}" />

                        <Label Grid.Row="3"
                               Grid.Column="0"
                               Content="Power (kW)" />
                        <TextBox Grid.Row="3"
                                 Grid.Column="1"
                                 Text="{Binding PowerKw, UpdateSourceTrigger=LostFocus}" />
                        <Label Grid.Row="3"
                               Grid.Column="2"
                               Content="Power (bhp)" />
                        <TextBox Grid.Row="3"
                                 Grid.Column="3"
                                 Text="{Binding PowerBhp, UpdateSourceTrigger=LostFocus}" />
                        <Label Grid.Row="3"
                               Grid.Column="4"
                               Content="Max RPM" />
                        <TextBox Grid.Row="3"
                                 Grid.Column="5"
                                 Text="{Binding MaxRpm, UpdateSourceTrigger=LostFocus}" />

                        <Label Grid.Row="4"
                               Grid.Column="0"
                               Content="Weight (kg)" />
                        <TextBox Grid.Row="4"
                                 Grid.Column="1"
                                 Text="{Binding WeightKg, UpdateSourceTrigger=LostFocus}" />
                        <Label Grid.Row="4"
                               Grid.Column="2"
                               Content="Max Fuel (L)" />
                        <TextBox Grid.Row="4"
                                 Grid.Column="3"
                                 Text="{Binding MaxFuel, UpdateSourceTrigger=LostFocus}" />

                        <Label Grid.Row="5"
                               Grid.Column="0"
                               Content="Length (mm)" />
                        <TextBox Grid.Row="5"
                                 Grid.Column="1"
                                 Text="{Binding LengthMm, UpdateSourceTrigger=LostFocus}" />
                        <Label Grid.Row="5"
                               Grid.Column="2"
                               Content="Width (mm)" />
                        <TextBox Grid.Row="5"
                                 Grid.Column="3"
                                 Text="{Binding WidthMm, UpdateSourceTrigger=LostFocus}" />
                        <Label Grid.Row="5"
                               Grid.Column="4"
                               Content="Height (mm)" />
                        <TextBox Grid.Row="5"
                                 Grid.Column="5"
                                 Text="{Binding HeightMm, UpdateSourceTrigger=LostFocus}" />
                    </Grid>

                    <Separator Margin="0,15,0,15" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Generate Core Provider"
                                Command="{Binding GenerateCoreProviderCommand}"
                                Padding="10,4"
                                Margin="0,0,15,0"
                                ToolTip="Regenerates SimRacingSdk.Lmu.Core's car model, interface and provider from every car saved here" />
                        <TextBlock Text="{Binding GenerateStatusMessage}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="SimRacingSdk.R3e.DataManager.SetupMaps.SetupMapsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SimRacingSdk.R3e.DataManager.SetupMaps"
             xmlns:controls="clr-namespace:SimRacingSdk.DataManager.Shared.Controls;assembly=SimRacingSdk.DataManager.Shared"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:SetupMapsViewModel}">
    <UserControl.Resources>
        <Style x:Key="CellTextBox"
               TargetType="TextBox">
            <Setter Property="MinWidth"
                    Value="70" />
            <Setter Property="Margin"
                    Value="2,1" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="controls:SelectAllOnFocus.IsEnabled"
                    Value="True" />
        </Style>

        <!-- Tab goes straight from one editor to the next; the cell around each one isn't a stop of its own. -->
        <Style x:Key="EditorCell"
               TargetType="DataGridCell">
            <Setter Property="IsTabStop"
                    Value="False" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,0,10">
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Search"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Matches name, manufacturer, class or game id. Every word must match, in any order, e.g. 'gt3 bmw'" />
            </DockPanel>
            <WrapPanel>
                <RadioButton Content="Owned"
                             GroupName="CarListFilter"
                             Margin="0,0,12,0"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=OwnedCars}" />
                <RadioButton Content="Owned, Not Mapped"
                             GroupName="CarListFilter"
                             Margin="0,0,12,0"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=OwnedNotMapped}" />
                <RadioButton Content="Mapped"
                             GroupName="CarListFilter"
                             Margin="0,0,12,0"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=MappedCars}" />
                <RadioButton Content="Not Validated"
                             GroupName="CarListFilter"
                             Margin="0,0,12,0"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=NotValidated}"
                             ToolTip="Every car the game's selector offers, except those with a validated map" />
                <RadioButton Content="All Cars"
                             GroupName="CarListFilter"
                             IsChecked="{Binding Filter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=AllCars}"
                             ToolTip="Every car the game's selector offers - tick Owned on the ones you have" />
            </WrapPanel>
            <TextBlock Text="{Binding ProgressMessage}"
                       Margin="0,6,0,0" />
        </StackPanel>

        <DataGrid Grid.Row="1"
                  Grid.Column="0"
                  ItemsSource="{Binding Cars}"
                  SelectedItem="{Binding SelectedCar, Mode=TwoWay}"
                  controls:ScrollSelectedIntoView.IsEnabled="True"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Owned">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsOwned, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Car.Name}"
                                    Width="*" />
                <DataGridTextColumn Header="Class"
                                    Binding="{Binding Car.Class}"
                                    Width="*" />
                <DataGridTextColumn Header="Map"
                                    Binding="{Binding MapStatus}" />
            </DataGrid.Columns>
        </DataGrid>

        <DockPanel Grid.Row="0"
                   Grid.Column="1"
                   Margin="10,0,0,10"
                   LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       FontSize="16"
                       VerticalAlignment="Bottom">
                <Run Text="{Binding Editor.CarName, Mode=OneWay}"
                     FontWeight="SemiBold" />
                <Run Text="{Binding Editor.CarClass, Mode=OneWay}"
                     Foreground="Gray" />
            </TextBlock>
            <CheckBox DockPanel.Dock="Right"
                      Content="Validated"
                      VerticalAlignment="Bottom"
                      IsChecked="{Binding Editor.Validated}"
                      ToolTip="Every row checked against the game's setup screen - only validated maps are written by Generate SDK Setup Maps" />
        </DockPanel>

        <DataGrid Grid.Row="1"
                  Grid.Column="1"
                  Margin="10,0,0,0"
                  ItemsSource="{Binding Editor.Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  CanUserSortColumns="False"
                  FrozenColumnCount="2"
                  HorizontalScrollBarVisibility="Auto"
                  CellStyle="{StaticResource EditorCell}">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="Bold"
                                       Margin="4,10,0,4" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Section"
                                    Binding="{Binding Section}" />
                <DataGridTextColumn Header="Control"
                                    Binding="{Binding Name}" />
                <DataGridTextColumn Header="Unit (Metric)"
                                    Binding="{Binding Unit}" />
                <DataGridTemplateColumn Header="Availability">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{x:Static local:AvailabilityOption.All}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Value"
                                      SelectedValue="{Binding Availability, UpdateSourceTrigger=PropertyChanged}"
                                      MinWidth="110"
                                      Margin="2,1" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Gears">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource CellTextBox}"
                                     MinWidth="45"
                                     IsEnabled="{Binding CanHaveGearCount}"
                                     Text="{Binding GearCountText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Number of forward gears" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Min">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource CellTextBox}"
                                     IsEnabled="{Binding CanHaveRange}"
                                     Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Step">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource CellTextBox}"
                                     IsEnabled="{Binding CanHaveRange}"
                                     Text="{Binding StepText, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Max">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource CellTextBox}"
                                     IsEnabled="{Binding CanHaveRange}"
                                     Text="{Binding MaxText, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Options"
                                        Width="*"
                                        MinWidth="250">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBox Style="{StaticResource CellTextBox}"
                                     IsEnabled="{Binding CanHaveOptions}"
                                     Text="{Binding OptionsText, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Separated by commas, in the game's order: compounds (Medium, Hard), final gear ratios (4.88, 4.56) or every gear tooth pair the gears can pick from, in the order the game steps through them (12:38, 15:36, ...)" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2"
                    Grid.Column="0"
                    Margin="0,10,0,0"
                    DataContext="{Binding Voice}">
            <Button Content="{Binding ToggleLabel}"
                    Command="{Binding ToggleListeningCommand}"
                    HorizontalAlignment="Left"
                    Padding="10,4"
                    ToolTip="Speak the map from the game: say next car, then e.g. front spring 120 to 220 step 20. Every command is said back. Say help for the rest" />
            <TextBlock Text="{Binding Status}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,4,0,0"
                       TextWrapping="Wrap">
                <Run Text="Heard:"
                     Foreground="Gray" />
                <Run Text="{Binding LastHeard, Mode=OneWay}" />
            </TextBlock>
            <TextBlock Margin="0,2,0,0"
                       TextWrapping="Wrap">
                <Run Text="Said:"
                     Foreground="Gray" />
                <Run Text="{Binding LastReply, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Grid.Column="1"
                    Margin="10,10,0,0">
            <!-- The status line is on its own row: at the end of the buttons a refused save's reason was cut off. -->
            <StackPanel Orientation="Horizontal">
                <Button Content="Save Setup Map"
                        Command="{Binding SaveSetupMapCommand}"
                        Padding="10,4"
                        Margin="0,0,10,0"
                        ToolTip="Also saved when you pick another car or close the Data Manager" />
                <Button Content="Reload"
                        Command="{Binding ReloadSetupMapCommand}"
                        Padding="10,4"
                        Margin="0,0,15,0"
                        ToolTip="Re-reads this car's setup map from disk, discarding unsaved edits" />
                <TextBlock Text="Copy from"
                           VerticalAlignment="Center"
                           Margin="0,0,5,0" />
                <ComboBox ItemsSource="{Binding MappedCars}"
                          SelectedItem="{Binding CopySourceCar}"
                          DisplayMemberPath="Label"
                          IsEditable="True"
                          TextSearch.TextPath="Label"
                          Width="300"
                          Margin="0,0,5,0"
                          ToolTip="Cars with a saved map. Start typing a name to find one" />
                <Button Content="Copy"
                        Command="{Binding CopyFromSourceCarCommand}"
                        Padding="10,4"
                        Margin="0,0,15,0"
                        ToolTip="Replaces the rows shown with the source car's map, unvalidated - check against the game, then save" />
                <Button Content="Generate SDK Setup Maps"
                        Command="{Binding GenerateSdkSetupMapsCommand}"
                        Padding="10,4"
                        Margin="0,0,15,0"
                        ToolTip="Writes every validated map into SimRacingSdk.R3e.Setups" />
            </StackPanel>
            <TextBlock Text="{Binding StatusMessage}"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>

<UserControl x:Class="SimRacingSdk.R3e.DataManager.Cars.CarsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SimRacingSdk.R3e.DataManager.Cars"
             xmlns:controls="clr-namespace:SimRacingSdk.DataManager.Shared.Controls;assembly=SimRacingSdk.DataManager.Shared"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:CarsViewModel}">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/SimRacingSdk.DataManager.Shared;component/Themes/EditorForm.xaml" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
            <RadioButton Content="By Class"
                         GroupName="CarBrowseMode"
                         VerticalAlignment="Center"
                         Margin="0,0,15,0"
                         IsChecked="{Binding BrowseMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ByGroup}" />
            <RadioButton Content="All Cars"
                         GroupName="CarBrowseMode"
                         VerticalAlignment="Center"
                         Margin="0,0,30,0"
                         IsChecked="{Binding BrowseMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All}" />
            <CheckBox Content="Selectable In Game Only"
                      VerticalAlignment="Center"
                      Margin="0,0,30,0"
                      IsChecked="{Binding IsSelectableOnly}"
                      ToolTip="Hides cars flagged Not In Game Selector (esports, safety cars, retired copies)" />
            <Button Content="Import From Game"
                    Command="{Binding ImportFromGameCommand}"
                    Padding="10,4"
                    Margin="0,0,15,0"
                    ToolTip="Adds new cars and refreshes names, manufacturers and classes from the game's own r3e-data.json, keeping everything captured here" />
            <TextBlock Text="{Binding ImportStatusMessage}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <ListBox Grid.Row="1"
                 Grid.Column="0"
                 ItemsSource="{Binding Groups}"
                 SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                 Visibility="{Binding IsByGroupMode, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="250" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      controls:ScrollSelectedIntoView.IsEnabled="True"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Manufacturer"
                                        Binding="{Binding Manufacturer}" />
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}" />
                    <DataGridTextColumn Header="Class"
                                        Binding="{Binding Class}" />
                    <DataGridTextColumn Header="Game Id"
                                        Binding="{Binding GameId}" />
                    <DataGridTextColumn Header="BHP"
                                        Binding="{Binding PowerBhp}" />
                    <DataGridTextColumn Header="Weight With Driver (kg)"
                                        Binding="{Binding WeightWithDriverKg}" />
                    <DataGridTextColumn Header="Capacity (L)"
                                        Binding="{Binding EngineCapacityLitres}" />
                    <DataGridTextColumn Header="Layout"
                                        Binding="{Binding EngineLayout}" />
                    <DataGridTextColumn Header="Drive"
                                        Binding="{Binding Drivetrain}" />
                </DataGrid.Columns>
            </DataGrid>

            <GroupBox Grid.Row="1"
                      Header="Car Details"
                      Margin="0,10,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,10,0,15">
                        <Button Content="Save Car"
                                Command="{Binding SaveCommand}"
                                Padding="10,4"
                                Margin="0,0,15,0" />
                        <TextBlock Text="{Binding SaveStatusMessage}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,15">
                        <Label Content="Copy spec from" />
                        <ComboBox Width="460"
                                  IsEditable="True"
                                  ItemsSource="{Binding SpecDonors}"
                                  DisplayMemberPath="Label"
                                  TextSearch.TextPath="Label"
                                  SelectedItem="{Binding SelectedSpecDonor}"
                                  ToolTip="Start typing a car's name to find one already captured. The choice stays selected, so the same spec can go onto several classes" />
                        <Button Content="Copy Spec"
                                Command="{Binding CopySpecCommand}"
                                Padding="10,4"
                                Margin="10,0,0,0"
                                ToolTip="Copies BHP, weight, engine and drive into the car below. Save to keep them" />
                    </StackPanel>

                    <Grid DataContext="{Binding Editor}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Content="Name" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 IsReadOnly="True"
                                 Text="{Binding Name, Mode=OneWay}"
                                 ToolTip="From the game's own data - refreshed by Import From Game" />
                        <Label Grid.Row="0"
                               Grid.Column="2"
                               Content="Manufacturer" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="3"
                                 IsReadOnly="True"
                                 Text="{Binding Manufacturer, Mode=OneWay}"
                                 ToolTip="From the game's own data - refreshed by Import From Game" />
                        <Label Grid.Row="0"
                               Grid.Column="4"
                               Content="Game Id" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="5"
                                 IsReadOnly="True"
                                 Text="{Binding GameId, Mode=OneWay}"
                                 ToolTip="The game's own model id, as shared memory and results files report it" />

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Content="Class" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 IsReadOnly="True"
                                 Text="{Binding CarClass, Mode=OneWay}"
                                 ToolTip="From the game's own data - refreshed by Import From Game" />
                        <Label Grid.Row="1"
                               Grid.Column="2"
                               Content="BHP" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="3"
                                 Text="{Binding PowerBhp, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" />
                        <Label Grid.Row="1"
                               Grid.Column="4"
                               Content="Weight With Driver (kg)" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="5"
                                 Text="{Binding WeightWithDriverKg, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" />

                        <Label Grid.Row="2"
                               Grid.Column="0"
                               Content="Capacity (L)" />
                        <TextBox Grid.Row="2"
                                 Grid.Column="1"
                                 Text="{Binding EngineCapacityLitres, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                 ToolTip="The number from the game's engine text, e.g. 1.8 for 1.8L Inline-4" />
                        <Label Grid.Row="2"
                               Grid.Column="2"
                               Content="Layout" />
                        <ComboBox Grid.Row="2"
                                  Grid.Column="3"
                                  IsEditable="True"
                                  ItemsSource="{Binding DataContext.Suggestions.EngineLayouts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Text="{Binding EngineLayout, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="The rest of the game's engine text, e.g. Inline-4. Start typing to complete one already used" />
                        <Label Grid.Row="2"
                               Grid.Column="4"
                               Content="Drive" />
                        <ComboBox Grid.Row="2"
                                  Grid.Column="5"
                                  ItemsSource="{x:Static local:Drivetrains.All}"
                                  SelectedItem="{Binding Drivetrain}"
                                  ToolTip="Type F, R or A to pick" />

                        <CheckBox Grid.Row="3"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="3"
                                  Margin="0,8,0,0"
                                  Content="Not In Game Selector"
                                  IsChecked="{Binding NotInGameSelector}"
                                  ToolTip="Tick for a car the game's car selector doesn't offer. It stays in the catalog so shared memory and results files can still name it" />
                    </Grid>

                    <Separator Margin="0,15,0,15" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Generate Core Provider"
                                Command="{Binding GenerateCoreProviderCommand}"
                                Padding="10,4"
                                Margin="0,0,15,0"
                                ToolTip="Regenerates SimRacingSdk.R3e.Core's car model, interface and provider from every car saved here" />
                        <TextBlock Text="{Binding GenerateStatusMessage}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>

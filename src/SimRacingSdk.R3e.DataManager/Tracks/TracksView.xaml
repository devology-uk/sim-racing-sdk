<UserControl x:Class="SimRacingSdk.R3e.DataManager.Tracks.TracksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SimRacingSdk.R3e.DataManager.Tracks"
             xmlns:controls="clr-namespace:SimRacingSdk.DataManager.Shared.Controls;assembly=SimRacingSdk.DataManager.Shared"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:TracksViewModel}">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/SimRacingSdk.DataManager.Shared;component/Themes/EditorForm.xaml" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
            <RadioButton Content="By Country"
                         GroupName="TrackBrowseMode"
                         VerticalAlignment="Center"
                         Margin="0,0,15,0"
                         IsChecked="{Binding BrowseMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ByGroup}" />
            <RadioButton Content="All Tracks"
                         GroupName="TrackBrowseMode"
                         VerticalAlignment="Center"
                         Margin="0,0,30,0"
                         IsChecked="{Binding BrowseMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All}" />
            <CheckBox Content="Selectable In Game Only"
                      VerticalAlignment="Center"
                      Margin="0,0,30,0"
                      IsChecked="{Binding IsSelectableOnly}"
                      ToolTip="Hides tracks flagged Not In Game Selector" />
            <Button Content="Import From Game"
                    Command="{Binding ImportFromGameCommand}"
                    Padding="10,4"
                    Margin="0,0,15,0"
                    ToolTip="Adds new tracks and layouts and refreshes their names and grid sizes from the game's own r3e-data.json, keeping everything captured here" />
            <TextBlock Text="{Binding ImportStatusMessage}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <ListBox Grid.Row="1"
                 Grid.Column="0"
                 ItemsSource="{Binding Groups}"
                 SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                 Visibility="{Binding IsByGroupMode, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="200" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      controls:ScrollSelectedIntoView.IsEnabled="True"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}" />
                    <DataGridTextColumn Header="Game Id"
                                        Binding="{Binding GameId}" />
                    <DataGridTextColumn Header="Country"
                                        Binding="{Binding Country}" />
                    <DataGridTextColumn Header="Layouts"
                                        Binding="{Binding Layouts.Count}" />
                </DataGrid.Columns>
            </DataGrid>

            <GroupBox Grid.Row="1"
                      Header="Track Details"
                      Margin="0,10,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,10,0,15">
                        <Button Content="Save Track"
                                Command="{Binding SaveCommand}"
                                Padding="10,4"
                                Margin="0,0,15,0" />
                        <TextBlock Text="{Binding SaveStatusMessage}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid DataContext="{Binding Editor}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Content="Name" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 IsReadOnly="True"
                                 Text="{Binding Name, Mode=OneWay}"
                                 ToolTip="From the game's own data - refreshed by Import From Game" />
                        <Label Grid.Row="0"
                               Grid.Column="2"
                               Content="Game Id" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="3"
                                 IsReadOnly="True"
                                 Text="{Binding GameId, Mode=OneWay}"
                                 ToolTip="The game's own track id, as shared memory reports it" />
                        <Label Grid.Row="0"
                               Grid.Column="4"
                               Content="Latitude" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="5"
                                 Text="{Binding Latitude, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" />

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Content="Country" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  IsEditable="True"
                                  ItemsSource="{Binding DataContext.Groups, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Text="{Binding Country, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Pick an existing country or type a new one" />
                        <Label Grid.Row="1"
                               Grid.Column="2"
                               Content="Country Code" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="3"
                                 Text="{Binding CountryCode, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="ISO 3166-1 alpha-3, e.g. GBR - matches the flag image file names" />
                        <Label Grid.Row="1"
                               Grid.Column="4"
                               Content="Longitude" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="5"
                                 Text="{Binding Longitude, UpdateSourceTrigger=LostFocus, TargetNullValue=''}" />

                        <CheckBox Grid.Row="2"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="3"
                                  Margin="0,8,0,0"
                                  Content="Not In Game Selector"
                                  IsChecked="{Binding NotInGameSelector}"
                                  ToolTip="Tick for a track the game's track selector doesn't offer. It stays in the catalog so shared memory and results files can still name it" />
                    </Grid>

                    <Separator Margin="0,15,0,15" />

                    <Label Content="Layouts" />
                    <Grid DataContext="{Binding Editor.Layouts}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ListBox Grid.Column="0"
                                 ItemsSource="{Binding Items}"
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                 DisplayMemberPath="Name"
                                 Height="140" />

                        <Grid Grid.Column="1"
                              Margin="15,0,0,0"
                              DataContext="{Binding SelectedItem}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Content="Layout Name" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     IsReadOnly="True"
                                     Text="{Binding Name, Mode=OneWay}"
                                     ToolTip="From the game's own data - refreshed by Import From Game" />
                            <Label Grid.Row="0"
                                   Grid.Column="2"
                                   Content="Game Id" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="3"
                                     IsReadOnly="True"
                                     Text="{Binding GameId, Mode=OneWay}"
                                     ToolTip="The game's own layout id, as shared memory reports it" />

                            <Label Grid.Row="1"
                                   Grid.Column="0"
                                   Content="Grid Size" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     IsReadOnly="True"
                                     Text="{Binding GridSize, Mode=OneWay}"
                                     ToolTip="The layout's maximum number of cars, from the game's own data" />
                            <Label Grid.Row="1"
                                   Grid.Column="2"
                                   Content="Length (km)" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="3"
                                     Text="{Binding LengthKm, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                     ToolTip="As the game's layout tile shows it" />
                        </Grid>
                    </Grid>

                    <Separator Margin="0,15,0,15" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Generate Core Provider"
                                Command="{Binding GenerateCoreProviderCommand}"
                                Padding="10,4"
                                Margin="0,0,15,0"
                                ToolTip="Regenerates SimRacingSdk.R3e.Core's track models, interface and provider from every track saved here" />
                        <TextBlock Text="{Binding GenerateStatusMessage}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>

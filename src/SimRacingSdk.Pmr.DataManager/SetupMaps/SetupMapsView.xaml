<UserControl x:Class="SimRacingSdk.Pmr.DataManager.SetupMaps.SetupMapsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SimRacingSdk.Pmr.DataManager.SetupMaps"
             xmlns:controls="clr-namespace:SimRacingSdk.Pmr.DataManager.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:SetupMapsViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
                  Grid.Column="0"
                  ItemsSource="{Binding Cars}"
                  SelectedItem="{Binding SelectedCar, Mode=TwoWay}"
                  controls:ScrollSelectedIntoView.IsEnabled="True"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Manufacturer"
                                     Binding="{Binding Manufacturer}" />
                <DataGridTextColumn Header="Name"
                                     Binding="{Binding Name}"
                                     Width="*" />
                <DataGridTextColumn Header="Year"
                                     Binding="{Binding Year}" />
            </DataGrid.Columns>
        </DataGrid>

        <TabControl Grid.Row="0"
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    SelectedIndex="{Binding DataContext.SelectedTabIndex, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                    DataContext="{Binding Editor}">
            <TabItem Header="Tyres &amp; Chassis">
                <local:SetupFieldsView DataContext="{Binding TyresAndChassis}" />
            </TabItem>
            <TabItem Header="Suspension">
                <local:SetupFieldsView DataContext="{Binding Suspension}" />
            </TabItem>
            <TabItem Header="Engine &amp; Drivetrain">
                <local:SetupFieldsView DataContext="{Binding EngineAndDrivetrain}" />
            </TabItem>
            <TabItem Header="Steering Wheel">
                <local:SetupFieldsView DataContext="{Binding SteeringWheel}" />
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1"
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Margin="10,10,0,0">
            <Button Content="Save Setup Map"
                    Command="{Binding SaveSetupMapCommand}"
                    Padding="10,4"
                    Margin="0,0,10,0" />
            <Button Content="Reload"
                    Command="{Binding ReloadSetupMapCommand}"
                    Padding="10,4"
                    Margin="0,0,15,0"
                    ToolTip="Re-reads this car's setup map from disk, discarding any unsaved edits" />
            <TextBlock Text="Copy from"
                       VerticalAlignment="Center"
                       Margin="0,0,5,0" />
            <ComboBox ItemsSource="{Binding Cars}"
                      SelectedItem="{Binding CopySourceCar}"
                      Width="220"
                      Margin="0,0,5,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Manufacturer, Mode=OneWay}" />
                            <Run Text="{Binding Name, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Content="Copy"
                    Command="{Binding CopyFromSourceCarCommand}"
                    Padding="10,4"
                    Margin="0,0,15,0"
                    ToolTip="Replaces the fields shown for the selected car with the source car's map - nothing is saved until Save Setup Map" />
            <Button Content="Add Default Fields"
                    Command="{Binding AddDefaultFieldsToSelectedCarCommand}"
                    Padding="10,4"
                    Margin="0,0,10,0"
                    ToolTip="Adds any missing standard field to the selected car only - for starting a new car. Nothing is saved until Save Setup Map" />
            <Button Content="Apply Force Feedback to All Cars"
                    Command="{Binding ApplyForceFeedbackToAllCarsCommand}"
                    Padding="10,4"
                    Margin="0,0,15,0"
                    ToolTip="Makes every car's Force Feedback section match the standard values - touches nothing else" />
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>

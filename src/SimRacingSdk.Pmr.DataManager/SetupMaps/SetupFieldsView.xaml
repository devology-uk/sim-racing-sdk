<UserControl x:Class="SimRacingSdk.Pmr.DataManager.SetupMaps.SetupFieldsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SimRacingSdk.Pmr.DataManager.SetupMaps"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:SetupFieldListViewModel}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding Fields}"
                  SelectedItem="{Binding SelectedField, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                     Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     Width="160" />
                <DataGridTextColumn Header="Section"
                                     Binding="{Binding Section, UpdateSourceTrigger=PropertyChanged}"
                                     Width="120" />
                <DataGridComboBoxColumn Header="Scope"
                                         ItemsSource="{x:Static local:SetupFieldScopeOptions.All}"
                                         SelectedItemBinding="{Binding Scope}"
                                         Width="90" />
                <DataGridComboBoxColumn Header="Kind"
                                         ItemsSource="{x:Static local:SetupFieldKindOptions.All}"
                                         SelectedItemBinding="{Binding Kind}"
                                         Width="80" />
                <DataGridTextColumn Header="Unit"
                                     Binding="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                     Width="60" />
                <DataGridTextColumn Header="Min"
                                     Binding="{Binding Min, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                     Width="70" />
                <DataGridTextColumn Header="Max"
                                     Binding="{Binding Max, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                     Width="70" />
                <DataGridTextColumn Header="Step"
                                     Binding="{Binding Step, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                     Width="70" />
                <DataGridTextColumn Header="Raw Key"
                                     Binding="{Binding RawKey, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                     Width="150" />
                <DataGridTextColumn Header="Raw Min"
                                     Binding="{Binding RawMin, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                     Width="90" />
                <DataGridTextColumn Header="Raw Max"
                                     Binding="{Binding RawMax, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                     Width="90" />
                <DataGridTextColumn Header="Raw Step"
                                     Binding="{Binding RawStep, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                                     Width="90" />
                <DataGridCheckBoxColumn Header="Auto Option"
                                         Binding="{Binding HasAutoOption}"
                                         Width="80" />
                <DataGridTextColumn Header="Enum Values (comma separated)"
                                     Binding="{Binding EnumValuesText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="0,10,0,0">
            <Button Content="Add Field"
                    Command="{Binding AddFieldCommand}"
                    Padding="10,4"
                    Margin="0,0,10,0" />
            <Button Content="Remove Field"
                    Command="{Binding RemoveFieldCommand}"
                    Padding="10,4" />
        </StackPanel>
    </Grid>
</UserControl>

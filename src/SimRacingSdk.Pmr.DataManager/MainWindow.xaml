<Window x:Class="SimRacingSdk.Pmr.DataManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimRacingSdk.Pmr.DataManager"
        xmlns:nav="clr-namespace:SimRacingSdk.Pmr.DataManager.Navigation"
        xmlns:cars="clr-namespace:SimRacingSdk.Pmr.DataManager.Cars"
        xmlns:tracks="clr-namespace:SimRacingSdk.Pmr.DataManager.Tracks"
        xmlns:setups="clr-namespace:SimRacingSdk.Pmr.DataManager.Setups"
        mc:Ignorable="d"
        Title="Sim Racing SDK Data Manager for Project Motor Racing"
        Height="800"
        Width="1200"
        d:DataContext="{d:DesignInstance local:MainWindowViewModel}">
    <Window.Resources>
        <DataTemplate DataType="{x:Type cars:CarsViewModel}">
            <cars:CarsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type tracks:TracksViewModel}">
            <tracks:TracksView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type setups:SetupsViewModel}">
            <setups:SetupsView />
        </DataTemplate>

        <Style x:Key="NavListBoxItemStyle"
               TargetType="ListBoxItem">
            <Setter Property="Padding"
                    Value="0" />
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="Foreground"
                    Value="#FFC8C8C8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderThickness="4,0,0,0"
                                BorderBrush="Transparent">
                            <ContentPresenter Margin="16,14" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#FF2D2D30" />
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="#FF3E9BFF" />
                                <Setter Property="Foreground"
                                        Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#FF262629" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10">
            <Button Content="Open Log Viewer"
                    Command="{Binding OpenLogViewerCommand}"
                    Margin="5"
                    ToolTip="Open a window for analysing log files" />
            <Button Content="Open Log Folder"
                    Command="{Binding OpenLogFolderCommand}"
                    Margin="5"
                    ToolTip="Open the folder containing the current log files" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0"
                     Background="#FF1E1E1E"
                     BorderThickness="0"
                     ItemsSource="{Binding NavigationItems}"
                     SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource NavListBoxItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type nav:NavigationItem}">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="15" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ContentControl Grid.Column="1"
                             Margin="16"
                             Content="{Binding CurrentPageViewModel}" />
        </Grid>
    </Grid>
</Window>

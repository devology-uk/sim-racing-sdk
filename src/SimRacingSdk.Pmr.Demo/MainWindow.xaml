<Window x:Class="SimRacingSdk.Pmr.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimRacingSdk.Pmr.Demo"
        xmlns:con="clr-namespace:SimRacingSdk.Pmr.Demo.Controls.Console"
        mc:Ignorable="d"
        Title="Sim Racing SDK Demo For Project Motor Racing"
        Height="800"
        Width="1024"
        d:DataContext="{d:DesignInstance local:MainWindowViewModel}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin"
                    Value="10" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0"
                    Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="10"
                    Visibility="{Binding IsRunningDemo, Converter={StaticResource BooleanToVisibilityInverseConverter}}">
            <Label Content="Host:"
                   VerticalAlignment="Center" />
            <TextBox Text="{Binding UdpHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="100"
                     VerticalAlignment="Center"
                     ToolTip="The IP address Project Motor Racing (or a relay tool like SimHub) sends its UDP telemetry to" />
            <Label Content="Port:"
                   VerticalAlignment="Center" />
            <TextBox Text="{Binding UdpPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Width="60"
                     VerticalAlignment="Center"
                     ToolTip="The port to listen for Project Motor Racing's UDP telemetry on" />
            <Button Content="UDP Demo"
                    Command="{Binding StartUdpDemoCommand}"
                    ToolTip="Start the demo of PmrUdpConnection for receiving Project Motor Racing's UDP telemetry broadcast" />
            <Button Content="Open Log Viewer"
                    Command="{Binding OpenLogViewerCommand}"
                    ToolTip="Open a window for analysing log files" />
            <Button Content="Open Log Folder"
                    Command="{Binding OpenLogFolderCommand}"
                    ToolTip="Open the folder containing the current log files" />
            <Button Content="Open Car Explorer"
                    Command="{Binding OpenCarExplorerCommand}"
                    ToolTip="Open the car explorer window" />
            <Button Content="Open Track Explorer"
                    Command="{Binding OpenTrackExplorerCommand}"
                    ToolTip="Open the track explorer window" />
        </StackPanel>

        <Button Grid.Column="0"
                Grid.Row="0"
                HorizontalAlignment="Center"
                Margin="10"
                Content="Stop Demo"
                Command="{Binding StopDemoCommand}"
                ToolTip="Stop the running demo"
                Visibility="{Binding IsRunningDemo, Converter={StaticResource BooleanToVisibilityConverter }}" />
        <con:ConsoleControl Grid.Column="0"
                             Grid.Row="1" />
    </Grid>
</Window>

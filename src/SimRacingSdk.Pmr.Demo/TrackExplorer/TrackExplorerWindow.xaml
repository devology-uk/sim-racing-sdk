<Window x:Class="SimRacingSdk.Pmr.Demo.TrackExplorer.TrackExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimRacingSdk.Pmr.Demo.TrackExplorer"
        mc:Ignorable="d"
        Title="Track Explorer"
        Height="500"
        Width="850"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        Background="LightGray"
        d:DataContext="{d:DesignInstance local:TrackExplorerViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <ListBox Grid.Column="0"
                 ItemsSource="{Binding Continents}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Stretch"
                 SelectedItem="{Binding SelectedContinent, Mode=TwoWay}"
                 MinWidth="120" />

        <ListBox Grid.Column="1"
                 ItemsSource="{Binding TrackNames}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Stretch"
                 SelectedItem="{Binding SelectedTrackName, Mode=TwoWay}"
                 MinWidth="200" />

        <ListBox Grid.Column="2"
                 ItemsSource="{Binding Layouts}"
                 DisplayMemberPath="LayoutName"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Stretch"
                 SelectedItem="{Binding SelectedLayout, Mode=TwoWay}"
                 MinWidth="140" />

        <GroupBox Grid.Column="3"
                  Header="Layout Details"
                  Margin="5"
                  VerticalAlignment="Top"
                  DataContext="{Binding SelectedLayout}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image Grid.Column="0"
                       Grid.Row="0"
                       Source="{Binding CountryCode, Converter={StaticResource FlagImageSourceConverter}}"
                       Width="64" />
                <Label Grid.Column="1"
                       Grid.Row="0"
                       Content="{Binding TrackName}"
                       FontWeight="Bold"
                       FontSize="16"
                       VerticalAlignment="Bottom" />

                <Label Grid.Column="0"
                       Grid.Row="1"
                       Content="City"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="1"
                       Content="{Binding City}" />

                <Label Grid.Column="0"
                       Grid.Row="2"
                       Content="Country"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="2"
                       Content="{Binding Country}" />

                <Label Grid.Column="0"
                       Grid.Row="3"
                       Content="Layout"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="3"
                       Content="{Binding LayoutName}" />

                <Label Grid.Column="0"
                       Grid.Row="4"
                       Content="Length (km)"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="4"
                       Content="{Binding LengthKm}" />

                <Label Grid.Column="0"
                       Grid.Row="5"
                       Content="Turns"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="5"
                       Content="{Binding Turns}" />

                <Label Grid.Column="0"
                       Grid.Row="6"
                       Content="Direction"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="6"
                       Content="{Binding Direction}" />

                <Label Grid.Column="0"
                       Grid.Row="7"
                       Content="Grid Size"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="7"
                       Content="{Binding GridSize}" />

                <Label Grid.Column="0"
                       Grid.Row="8"
                       Content="Altitude (m AMSL)"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="8"
                       Content="{Binding AltitudeMetresAmsl}" />

                <Label Grid.Column="0"
                       Grid.Row="9"
                       Content="Lat / Long"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="9"
                       Content="{Binding Latitude}" />

                <Label Grid.Column="0"
                       Grid.Row="10"
                       Content="Pit Speed Limit (m/s)"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="10"
                       Content="{Binding PitSpeedLimitMetresPerSecond}" />

                <Label Grid.Column="0"
                       Grid.Row="11"
                       Content="Year"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="11"
                       Content="{Binding TrackYear}" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>

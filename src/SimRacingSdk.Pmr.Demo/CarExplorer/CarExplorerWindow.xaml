<Window x:Class="SimRacingSdk.Pmr.Demo.CarExplorer.CarExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimRacingSdk.Pmr.Demo.CarExplorer"
        mc:Ignorable="d"
        Title="Car Explorer"
        Height="700"
        Width="950"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        Background="LightGray"
        d:DataContext="{d:DesignInstance local:CarExplorerViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <ListBox Grid.Column="0"
                 Grid.Row="0"
                 Grid.RowSpan="2"
                 ItemsSource="{Binding Manufacturers}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Stretch"
                 SelectedItem="{Binding SelectedManufacturer, Mode=TwoWay}" />

        <DataGrid Grid.Column="1"
                  Grid.Row="0"
                  ItemsSource="{Binding Cars}"
                  SelectedItem="{Binding SelectedCar, Mode=TwoWay}"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Stretch"
                  Height="200"
                  AutoGenerateColumns="False"
                  Margin="5"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}" />
                <DataGridTextColumn Header="Class"
                                    Binding="{Binding VehicleClass}" />
                <DataGridTextColumn Header="Year"
                                    Binding="{Binding Year}" />
                <DataGridTextColumn Header="Power (kW)"
                                    Binding="{Binding PowerKw}" />
                <DataGridTextColumn Header="Torque (Nm)"
                                    Binding="{Binding TorqueNm}" />
                <DataGridTextColumn Header="Weight (KG)"
                                    Binding="{Binding WeightKg}" />
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Column="1"
                  Grid.Row="1"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Header="Car Details"
                  DataContext="{Binding SelectedCar}"
                  Margin="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image Grid.Column="0"
                       Grid.Row="0"
                       Source="{Binding IconFileName, Converter={StaticResource CarManufacturerImageSourceConverter}}"
                       Width="64"
                       VerticalAlignment="Center" />
                <Label Grid.Column="1"
                       Grid.Row="0"
                       Grid.ColumnSpan="5"
                       FontWeight="Bold"
                       FontSize="16"
                       Content="{Binding DisplayName}"
                       VerticalAlignment="Center" />

                <Label Grid.Column="0"
                       Grid.Row="1"
                       Content="Vehicle Class"
                       HorizontalAlignment="Left"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="1"
                       Content="{Binding VehicleClass}"
                       HorizontalAlignment="Left" />

                <Label Grid.Column="2"
                       Grid.Row="1"
                       Content="Engine Type"
                       HorizontalAlignment="Left"
                       FontWeight="SemiBold" />
                <Label Grid.Column="3"
                       Grid.Row="1"
                       Content="{Binding EngineType}"
                       HorizontalAlignment="Left" />

                <Label Grid.Column="4"
                       Grid.Row="1"
                       Content="Displacement (L)"
                       HorizontalAlignment="Left"
                       FontWeight="SemiBold" />
                <Label Grid.Column="5"
                       Grid.Row="1"
                       Content="{Binding EngineDisplacementLitres}"
                       HorizontalAlignment="Left" />

                <Label Grid.Column="0"
                       Grid.Row="2"
                       Content="Engine Layout"
                       HorizontalAlignment="Left"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="2"
                       Content="{Binding EngineLayout}"
                       HorizontalAlignment="Left" />

                <Label Grid.Column="2"
                       Grid.Row="2"
                       Content="Powertrain"
                       HorizontalAlignment="Left"
                       FontWeight="SemiBold" />
                <Label Grid.Column="3"
                       Grid.Row="2"
                       Content="{Binding PowertrainLayout}"
                       HorizontalAlignment="Left" />

                <Label Grid.Column="4"
                       Grid.Row="2"
                       Content="Transmission"
                       HorizontalAlignment="Left"
                       FontWeight="SemiBold" />
                <Label Grid.Column="5"
                       Grid.Row="2"
                       Content="{Binding Transmission}"
                       HorizontalAlignment="Left" />

                <Label Grid.Column="0"
                       Grid.Row="3"
                       Content="Power (kW)"
                       HorizontalAlignment="Left"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="3"
                       Content="{Binding PowerKw}"
                       HorizontalAlignment="Left" />

                <Label Grid.Column="2"
                       Grid.Row="3"
                       Content="Torque (Nm)"
                       HorizontalAlignment="Left"
                       FontWeight="SemiBold" />
                <Label Grid.Column="3"
                       Grid.Row="3"
                       Content="{Binding TorqueNm}"
                       HorizontalAlignment="Left" />

                <Label Grid.Column="4"
                       Grid.Row="3"
                       Content="Weight (KG)"
                       HorizontalAlignment="Left"
                       FontWeight="SemiBold" />
                <Label Grid.Column="5"
                       Grid.Row="3"
                       Content="{Binding WeightKg}"
                       HorizontalAlignment="Left" />

                <Label Grid.Column="0"
                       Grid.Row="4"
                       Content="Fuel Capacity (L)"
                       HorizontalAlignment="Left"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="4"
                       Content="{Binding FuelCapacityLitres, TargetNullValue='Virtual Energy'}"
                       HorizontalAlignment="Left" />

                <Label Grid.Column="2"
                       Grid.Row="4"
                       Content="Id"
                       HorizontalAlignment="Left"
                       FontWeight="SemiBold" />
                <Label Grid.Column="3"
                       Grid.Row="4"
                       Content="{Binding Id}"
                       HorizontalAlignment="Left" />

                <Label Grid.Column="4"
                       Grid.Row="4"
                       Content="Year"
                       HorizontalAlignment="Left"
                       FontWeight="SemiBold" />
                <Label Grid.Column="5"
                       Grid.Row="4"
                       Content="{Binding Year}"
                       HorizontalAlignment="Left" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>

<UserControl x:Class="SimRacingSdk.Ace.DataManager.Tracks.TracksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SimRacingSdk.Ace.DataManager.Tracks"
             xmlns:controls="clr-namespace:SimRacingSdk.DataManager.Shared.Controls;assembly=SimRacingSdk.DataManager.Shared"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance local:TracksViewModel}">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/SimRacingSdk.DataManager.Shared;component/Themes/EditorForm.xaml" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
            <RadioButton Content="By Continent"
                         GroupName="TrackBrowseMode"
                         VerticalAlignment="Center"
                         Margin="0,0,15,0"
                         IsChecked="{Binding BrowseMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ByGroup}" />
            <RadioButton Content="All Tracks"
                         GroupName="TrackBrowseMode"
                         VerticalAlignment="Center"
                         IsChecked="{Binding BrowseMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All}" />
        </StackPanel>

        <ListBox Grid.Row="1"
                 Grid.Column="0"
                 ItemsSource="{Binding Groups}"
                 SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                 Visibility="{Binding IsByGroupMode, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="200" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      controls:ScrollSelectedIntoView.IsEnabled="True"
                      AutoGenerateColumns="False"
                      IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Short Name"
                                        Binding="{Binding ShortName}" />
                    <DataGridTextColumn Header="Name"
                                        Binding="{Binding Name}" />
                    <DataGridTextColumn Header="Continent"
                                        Binding="{Binding Continent}" />
                    <DataGridTextColumn Header="Country"
                                        Binding="{Binding CountryCode}" />
                    <DataGridTextColumn Header="Layouts"
                                        Binding="{Binding Layouts.Count}" />
                </DataGrid.Columns>
            </DataGrid>

            <GroupBox Grid.Row="1"
                      Header="Track Details"
                      Margin="0,10,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Margin="0,10,0,15">
                        <Button Content="New Track"
                                Command="{Binding NewCommand}"
                                Padding="10,4"
                                Margin="0,0,10,0" />
                        <Button Content="Save Track"
                                Command="{Binding SaveCommand}"
                                Padding="10,4"
                                Margin="0,0,15,0" />
                        <TextBlock Text="{Binding SaveStatusMessage}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <Grid DataContext="{Binding Editor}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Content="Name" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="1"
                                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="The track name ACE's shared memory reports, which is also its setup folder name" />
                        <Label Grid.Row="0"
                               Grid.Column="2"
                               Content="Short Name" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="3"
                                 Text="{Binding ShortName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Shown in the app, and used to match shared setups to a track" />
                        <Label Grid.Row="0"
                               Grid.Column="4"
                               Content="Latitude" />
                        <TextBox Grid.Row="0"
                                 Grid.Column="5"
                                 Text="{Binding Latitude, UpdateSourceTrigger=LostFocus}" />

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Content="Continent" />
                        <ComboBox Grid.Row="1"
                                  Grid.Column="1"
                                  IsEditable="True"
                                  ItemsSource="{Binding DataContext.Groups, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  Text="{Binding Continent, UpdateSourceTrigger=PropertyChanged}"
                                  ToolTip="Pick an existing continent or type a new one" />
                        <Label Grid.Row="1"
                               Grid.Column="2"
                               Content="Country Code" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="3"
                                 Text="{Binding CountryCode, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="ISO 3166-1 alpha-3, e.g. GBR-ENG - matches the flag image file names" />
                        <Label Grid.Row="1"
                               Grid.Column="4"
                               Content="Longitude" />
                        <TextBox Grid.Row="1"
                                 Grid.Column="5"
                                 Text="{Binding Longitude, UpdateSourceTrigger=LostFocus}" />
                    </Grid>

                    <Separator Margin="0,15,0,15" />

                    <Label Content="Layouts" />
                    <Grid DataContext="{Binding Editor.Layouts}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <ListBox ItemsSource="{Binding Items}"
                                     SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                     DisplayMemberPath="Name"
                                     Height="110" />
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,8,0,0">
                                <Button Content="Add Layout"
                                        Command="{Binding AddCommand}"
                                        Padding="10,4"
                                        Margin="0,0,10,0" />
                                <Button Content="Remove Layout"
                                        Command="{Binding RemoveCommand}"
                                        Padding="10,4" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Column="1"
                              Margin="15,0,0,0"
                              DataContext="{Binding SelectedItem}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0"
                                   Grid.Column="0"
                                   Content="Layout Name" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            <Label Grid.Row="0"
                                   Grid.Column="2"
                                   Content="Corners" />
                            <TextBox Grid.Row="0"
                                     Grid.Column="3"
                                     Text="{Binding Corners, UpdateSourceTrigger=LostFocus}" />

                            <Label Grid.Row="1"
                                   Grid.Column="0"
                                   Content="Length (m)" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding LengthMeters, UpdateSourceTrigger=LostFocus}" />
                            <Label Grid.Row="1"
                                   Grid.Column="2"
                                   Content="Max Pit Slot" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="3"
                                     Text="{Binding MaxPitSlot, UpdateSourceTrigger=LostFocus}" />
                        </Grid>
                    </Grid>

                    <Separator Margin="0,15,0,15" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Generate Core Provider"
                                Command="{Binding GenerateCoreProviderCommand}"
                                Padding="10,4"
                                Margin="0,0,15,0"
                                ToolTip="Regenerates SimRacingSdk.Ace.Core's track models, interface and provider from every track saved here" />
                        <TextBlock Text="{Binding GenerateStatusMessage}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>

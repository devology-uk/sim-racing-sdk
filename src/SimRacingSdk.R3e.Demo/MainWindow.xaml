<Window x:Class="SimRacingSdk.R3e.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimRacingSdk.R3e.Demo"
        xmlns:con="clr-namespace:SimRacingSdk.R3e.Demo.Controls.Console"
        mc:Ignorable="d"
        Title="Sim Racing SDK Demo For RaceRoom Racing Experience"
        Height="800"
        Width="1024"
        d:DataContext="{d:DesignInstance local:MainWindowViewModel}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin"
                    Value="10" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="10">
            <Button Content="Game Info"
                    Command="{Binding ShowGameInfoCommand}"
                    ToolTip="Show what R3e.Core finds on this machine: install and user data paths, game options and compatibility checks" />
            <Button Content="Open Log Viewer"
                    Command="{Binding OpenLogViewerCommand}"
                    ToolTip="Open a window for analysing log files" />
            <Button Content="Open Log Folder"
                    Command="{Binding OpenLogFolderCommand}"
                    ToolTip="Open the folder containing the current log files" />
            <Button Content="Open Car Explorer"
                    Command="{Binding OpenCarExplorerCommand}"
                    ToolTip="Open the car explorer window" />
            <Button Content="Open Track Explorer"
                    Command="{Binding OpenTrackExplorerCommand}"
                    ToolTip="Open the track explorer window" />
        </StackPanel>

        <con:ConsoleControl Grid.Row="1" />
    </Grid>
</Window>

<Window x:Class="SimRacingSdk.R3e.Demo.TrackExplorer.TrackExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimRacingSdk.R3e.Demo.TrackExplorer"
        mc:Ignorable="d"
        Title="Track Explorer"
        Height="500"
        Width="1000"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        Background="LightGray"
        d:DataContext="{d:DesignInstance local:TrackExplorerViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <CheckBox Grid.Column="0"
                  Grid.Row="0"
                  Grid.ColumnSpan="4"
                  Margin="5"
                  Content="Selectable in game only"
                  IsChecked="{Binding IsSelectableOnly}"
                  ToolTip="Hides tracks flagged NotInGameSelector" />

        <ListBox Grid.Column="0"
                 Grid.Row="1"
                 ItemsSource="{Binding Countries}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Stretch"
                 SelectedItem="{Binding SelectedCountry, Mode=TwoWay}"
                 MinWidth="140" />

        <ListBox Grid.Column="1"
                 Grid.Row="1"
                 ItemsSource="{Binding Tracks}"
                 DisplayMemberPath="Name"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Stretch"
                 SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                 MinWidth="240" />

        <ListBox Grid.Column="2"
                 Grid.Row="1"
                 ItemsSource="{Binding SelectedTrack.Layouts}"
                 DisplayMemberPath="Name"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Stretch"
                 SelectedItem="{Binding SelectedLayout, Mode=TwoWay}"
                 MinWidth="160" />

        <GroupBox Grid.Column="3"
                  Grid.Row="1"
                  Header="Layout Details"
                  Margin="5"
                  VerticalAlignment="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image Grid.Column="0"
                       Grid.Row="0"
                       Source="{Binding SelectedTrack.CountryCode, Converter={StaticResource FlagImageSourceConverter}}"
                       Width="64" />
                <Label Grid.Column="1"
                       Grid.Row="0"
                       Content="{Binding SelectedTrack.Name}"
                       FontWeight="Bold"
                       FontSize="16"
                       VerticalAlignment="Bottom" />

                <Label Grid.Column="0"
                       Grid.Row="1"
                       Content="Country"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="1"
                       Content="{Binding SelectedTrack.Country}" />

                <Label Grid.Column="0"
                       Grid.Row="2"
                       Content="Track Game Id"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="2"
                       Content="{Binding SelectedTrack.GameId}" />

                <Label Grid.Column="0"
                       Grid.Row="3"
                       Content="Latitude"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="3"
                       Content="{Binding SelectedTrack.Latitude}" />

                <Label Grid.Column="0"
                       Grid.Row="4"
                       Content="Longitude"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="4"
                       Content="{Binding SelectedTrack.Longitude}" />

                <Label Grid.Column="0"
                       Grid.Row="5"
                       Content="Layout Game Id"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="5"
                       Content="{Binding SelectedLayout.GameId}" />

                <Label Grid.Column="0"
                       Grid.Row="6"
                       Content="Length (km)"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="6"
                       Content="{Binding SelectedLayout.LengthKm, TargetNullValue='-'}" />

                <Label Grid.Column="0"
                       Grid.Row="7"
                       Content="Grid Size"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="7"
                       Content="{Binding SelectedLayout.GridSize}" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>

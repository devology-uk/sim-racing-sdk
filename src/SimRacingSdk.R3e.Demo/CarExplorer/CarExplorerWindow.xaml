<Window x:Class="SimRacingSdk.R3e.Demo.CarExplorer.CarExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimRacingSdk.R3e.Demo.CarExplorer"
        mc:Ignorable="d"
        Title="Car Explorer"
        Height="700"
        Width="1050"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        Background="LightGray"
        d:DataContext="{d:DesignInstance local:CarExplorerViewModel}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <CheckBox Grid.Column="0"
                  Grid.Row="0"
                  Grid.ColumnSpan="2"
                  Margin="5"
                  Content="Selectable in game only"
                  IsChecked="{Binding IsSelectableOnly}"
                  ToolTip="Hides cars flagged NotInGameSelector (esports, safety cars, retired copies)" />

        <ListBox Grid.Column="0"
                 Grid.Row="1"
                 Grid.RowSpan="2"
                 ItemsSource="{Binding Classes}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Stretch"
                 MinWidth="200"
                 SelectedItem="{Binding SelectedClass, Mode=TwoWay}" />

        <DataGrid Grid.Column="1"
                  Grid.Row="1"
                  ItemsSource="{Binding Cars}"
                  SelectedItem="{Binding SelectedCar, Mode=TwoWay}"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Stretch"
                  Height="250"
                  AutoGenerateColumns="False"
                  Margin="5"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Manufacturer"
                                    Binding="{Binding Manufacturer}" />
                <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}" />
                <DataGridTextColumn Header="BHP"
                                    Binding="{Binding PowerBhp}" />
                <DataGridTextColumn Header="Weight With Driver (kg)"
                                    Binding="{Binding WeightWithDriverKg}" />
                <DataGridTextColumn Header="Drive"
                                    Binding="{Binding Drivetrain}" />
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Column="1"
                  Grid.Row="2"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Top"
                  Header="Car Details"
                  DataContext="{Binding SelectedCar}"
                  Margin="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Image Grid.Column="0"
                       Grid.Row="0"
                       Source="{Binding Manufacturer, Converter={StaticResource CarManufacturerImageSourceConverter}}"
                       Width="64"
                       VerticalAlignment="Center" />
                <Label Grid.Column="1"
                       Grid.Row="0"
                       Grid.ColumnSpan="5"
                       FontWeight="Bold"
                       FontSize="16"
                       Content="{Binding Name}"
                       VerticalAlignment="Center" />

                <Label Grid.Column="0"
                       Grid.Row="1"
                       Content="Class"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="1"
                       Content="{Binding Class}" />
                <Label Grid.Column="2"
                       Grid.Row="1"
                       Content="Manufacturer"
                       FontWeight="SemiBold" />
                <Label Grid.Column="3"
                       Grid.Row="1"
                       Content="{Binding Manufacturer}" />
                <Label Grid.Column="4"
                       Grid.Row="1"
                       Content="Game Id"
                       FontWeight="SemiBold" />
                <Label Grid.Column="5"
                       Grid.Row="1"
                       Content="{Binding GameId}" />

                <Label Grid.Column="0"
                       Grid.Row="2"
                       Content="Capacity (L)"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="2"
                       Content="{Binding EngineCapacityLitres, TargetNullValue='-'}" />
                <Label Grid.Column="2"
                       Grid.Row="2"
                       Content="Engine Layout"
                       FontWeight="SemiBold" />
                <Label Grid.Column="3"
                       Grid.Row="2"
                       Content="{Binding EngineLayout}" />
                <Label Grid.Column="4"
                       Grid.Row="2"
                       Content="Drive"
                       FontWeight="SemiBold" />
                <Label Grid.Column="5"
                       Grid.Row="2"
                       Content="{Binding Drivetrain}" />

                <Label Grid.Column="0"
                       Grid.Row="3"
                       Content="Power (BHP)"
                       FontWeight="SemiBold" />
                <Label Grid.Column="1"
                       Grid.Row="3"
                       Content="{Binding PowerBhp, TargetNullValue='-'}" />
                <Label Grid.Column="2"
                       Grid.Row="3"
                       Content="Weight With Driver (kg)"
                       FontWeight="SemiBold" />
                <Label Grid.Column="3"
                       Grid.Row="3"
                       Content="{Binding WeightWithDriverKg, TargetNullValue='-'}" />
                <Label Grid.Column="4"
                       Grid.Row="3"
                       Content="Not In Game Selector"
                       FontWeight="SemiBold" />
                <Label Grid.Column="5"
                       Grid.Row="3"
                       Content="{Binding NotInGameSelector}" />
            </Grid>
        </GroupBox>
    </Grid>
</Window>

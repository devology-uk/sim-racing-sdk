<Window x:Class="SimRacingSdk.Lmu.Demo.RestExplorer.RestExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimRacingSdk.Lmu.Demo.RestExplorer"
        xmlns:con="clr-namespace:SimRacingSdk.Lmu.Demo.Controls.Console"
        mc:Ignorable="d"
        Title="REST Explorer"
        Height="850"
        Width="1200"
        WindowStartupLocation="CenterOwner"
        d:DataContext="{d:DesignInstance local:RestExplorerViewModel}">
    <Window.Resources>
        <CollectionViewSource x:Key="GroupedEndpoints"
                              Source="{Binding Endpoints}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <Style TargetType="Button">
            <Setter Property="Margin"
                    Value="5" />
            <Setter Property="Padding"
                    Value="10,3" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal">
            <Label Content="Base address" />
            <TextBox Text="{Binding BaseAddress, UpdateSourceTrigger=PropertyChanged}"
                     Width="180"
                     VerticalAlignment="Center" />
            <Label Content="Game state"
                   Margin="20,0,0,0" />
            <ComboBox ItemsSource="{Binding CaptureStates}"
                      SelectedItem="{Binding SelectedCaptureState}"
                      Width="160"
                      VerticalAlignment="Center"
                      ToolTip="Responses are saved under a folder for this state" />
            <Button Content="Capture All Safe Reads"
                    Command="{Binding CaptureAllSafeReadsCommand}"
                    ToolTip="Calls every read-only endpoint once and saves each response under the chosen game state" />
            <Button Content="Start Monitor"
                    Command="{Binding StartMonitorCommand}"
                    Margin="20,5,5,5"
                    ToolTip="Polls the API in the background, works out the game state itself and records responses and every state, window and availability change under logs\rest-monitor" />
            <Button Content="Stop Monitor"
                    Command="{Binding StopMonitorCommand}" />
            <Button Content="Open Logs Folder"
                    Command="{Binding OpenCaptureFolderCommand}"
                    Margin="20,5,5,5" />
        </StackPanel>

        <ListBox Grid.Row="1"
                 Grid.Column="0"
                 Margin="0,5,5,5"
                 ItemsSource="{Binding Source={StaticResource GroupedEndpoints}}"
                 SelectedItem="{Binding SelectedEndpoint}">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="Bold"
                                       Margin="0,6,0,2" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Kind}"
                                   Width="110"
                                   Foreground="Gray" />
                        <TextBlock Text="{Binding DisplayName}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="5,5,0,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding SelectedEndpoint.DisplayName, FallbackValue='Select an endpoint'}"
                       FontWeight="Bold"
                       FontSize="14" />

            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding RouteValues}"
                          Margin="0,5">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,2">
                            <Label Content="{Binding Name}"
                                   Width="160" />
                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                     Width="250"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="2">
                <Label Content="Request body (POST/PUT only, optional JSON)" />
                <TextBox Text="{Binding RequestBody, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding AcceptsBody}"
                         Height="50"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontFamily="Consolas" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Send"
                            Command="{Binding SendSelectedCommand}"
                            Margin="0,5,5,5" />
                    <CheckBox Content="After an action, also capture focus, camera info and replay state"
                              IsChecked="{Binding IsSnapshotAfterAction}"
                              VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <TextBox Grid.Row="3"
                     Text="{Binding LastResponseText, Mode=OneWay}"
                     IsReadOnly="True"
                     FontFamily="Consolas"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" />
        </Grid>

        <con:ConsoleControl Grid.Row="2"
                            Grid.ColumnSpan="2" />
    </Grid>
</Window>
